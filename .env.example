# Copy to .env.local for local work, and add the same keys in Netlify → Project configuration → Environment variables.

# --- Sanity CMS (sanity.io/manage → your project) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Secret shared with the Sanity webhook that refreshes the site on publish
SANITY_REVALIDATE_SECRET=
# Only needed on your computer to run "npm run seed" once (Editor token). Do not add to the host.
SANITY_WRITE_TOKEN=

# --- Google Apps Script booking backend (see apps-script/SETUP.md) ---
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# --- Razorpay (leave empty until the account is approved; the site uses manual UPI meanwhile) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
